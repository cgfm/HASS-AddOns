map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080 default_server;
    server_name _;
    client_max_body_size 50m;

    # ── Static scripts ────────────────────────────────────────────────
    location = /ingress.js {
        alias /usr/share/ingress.js;
        default_type application/javascript;
    }

    location = /auto-auth.js {
        alias /usr/share/auto-auth.js;
        default_type application/javascript;
    }

    # ── API & PocketBase admin — pass through as-is (no SPA fallback) ─
    location ~ ^/(api/|_/) {
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_cookie_path / %%INGRESS_PATH%%/;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # ── SPA routes — proxy with HTML rewriting + 404 fallback ─────────
    location / {
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_cookie_path / %%INGRESS_PATH%%/;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # If PocketBase returns 404 for a SPA route, serve root instead
        proxy_intercept_errors on;
        error_page 404 = @spa_fallback;

        # Rewrite HTML
        sub_filter_once off;

        # 1) Inject scripts (absolute paths — will be rewritten by step 2)
        sub_filter '</head>' '<script src="/ingress.js"></script><script src="/auto-auth.js"></script></head>';

        # 2) Rewrite absolute asset paths so they go through ingress
        sub_filter 'href="/' 'href="%%INGRESS_PATH%%/';
        sub_filter "href='/" "href='%%INGRESS_PATH%%/";
        sub_filter 'src="/' 'src="%%INGRESS_PATH%%/';
        sub_filter "src='/" "src='%%INGRESS_PATH%%/";
        sub_filter 'action="/' 'action="%%INGRESS_PATH%%/';
    }

    # ── SPA fallback: re-request root from PocketBase ─────────────────
    location @spa_fallback {
        internal;
        rewrite ^ / break;
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Host $http_host;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;

        sub_filter_once off;
        sub_filter '</head>' '<script src="/ingress.js"></script><script src="/auto-auth.js"></script></head>';
        sub_filter 'href="/' 'href="%%INGRESS_PATH%%/';
        sub_filter "href='/" "href='%%INGRESS_PATH%%/";
        sub_filter 'src="/' 'src="%%INGRESS_PATH%%/';
        sub_filter "src='/" "src='%%INGRESS_PATH%%/";
        sub_filter 'action="/' 'action="%%INGRESS_PATH%%/';
    }
}
